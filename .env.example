DATABASE_URL=postgresql://postgres:postgres@localhost:54329/shop_dev
# Hosted Postgres behind a transaction pooler (Supabase): DATABASE_URL = pooler on port 6543,
# DIRECT_URL = session pooler on port 5432 (used by migrations and the seed). Leave unset locally.
# DIRECT_URL=
STORE_SLUG=default
SEED_ADMIN_NAME=Store Owner
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Owner-123
